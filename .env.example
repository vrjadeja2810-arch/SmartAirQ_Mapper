# ==============================================================================
# Smart Air Quality Mapper - Environment Variables
# Copy this file to '.env' and insert your private API keys.
# '.env' is automatically ignored by Git and will NEVER be pushed to GitHub.
# ==============================================================================

# Carto Basemaps API Key
CARTO_API_KEY=your_carto_api_key_here

# Carto Map Style Preset: voyager, positron, or dark_all
CARTO_MAP_STYLE=voyager

# Flask Server Port (Default: 5000)
PORT=5000
